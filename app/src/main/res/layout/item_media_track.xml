<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/bg_favorite_item"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false">

    <!-- Stare Redare / Icon Piesa -->
    <FrameLayout
        android:id="@+id/track_icon_frame"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_circle_photo"
        android:foreground="@drawable/bg_circle_photo_border"
        android:padding="8dp">

        <ImageView
            android:id="@+id/item_track_play_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_media_play"
            app:tint="@color/bmw_amber" />
    </FrameLayout>

    <!-- Titlu & Artist + Durata -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_track_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Titlu Piesă"
            android:textColor="@color/bmw_white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/item_track_artist_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Artist • 3:45"
            android:textColor="@color/bmw_amber"
            android:textSize="12sp"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Buton Favorit (Stea) -->
    <FrameLayout
        android:id="@+id/btn_track_favorite"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_radio_btn_edit"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="false">

        <ImageView
            android:id="@+id/item_track_fav_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_star_border"
            app:tint="@color/bmw_amber" />
    </FrameLayout>

    <!-- Buton Optiuni Playlist (Adaugare / Stergere din playlist) -->
    <FrameLayout
        android:id="@+id/btn_track_playlist_action"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_panel_action_btn"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="false">

        <ImageView
            android:id="@+id/item_track_playlist_action_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_add"
            app:tint="@color/bmw_white" />
    </FrameLayout>

</LinearLayout>
