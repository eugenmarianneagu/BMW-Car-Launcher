<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state (glowing amber border from ESP32 DPAD selection) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/bmw_dark_card_focused" />
            <stroke android:width="3dp" android:color="@color/bmw_amber" />
        </shape>
    </item>

    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/bmw_amber_glow" />
            <stroke android:width="3dp" android:color="@color/bmw_amber_light" />
        </shape>
    </item>

    <!-- Normal / Unfocused state -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/bmw_dark_card" />
            <stroke android:width="1.5dp" android:color="@color/bmw_dark_border" />
        </shape>
    </item>
</selector>
