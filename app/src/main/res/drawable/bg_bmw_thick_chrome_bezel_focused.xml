<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Outer Amber Glow Shadow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#33FF7500" />
        </shape>
    </item>

    <!-- 2. Vibrant BMW Amber Glowing Bezel Rim -->
    <item
        android:top="2dp"
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp">
        <shape android:shape="oval">
            <stroke
                android:width="6dp"
                android:color="#FF7500" />
            <solid android:color="#000000" />
        </shape>
    </item>

</layer-list>
