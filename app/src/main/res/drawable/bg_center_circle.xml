<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state for Central Circle -->
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/bmw_dark_card_focused" />
            <stroke android:width="4dp" android:color="@color/bmw_amber" />
        </shape>
    </item>

    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/bmw_dark_card_focused" />
            <stroke android:width="4dp" android:color="@color/bmw_amber_light" />
        </shape>
    </item>

    <!-- Normal / Unfocused state -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/bmw_black" />
            <stroke android:width="2dp" android:color="@color/bmw_dark_border" />
        </shape>
    </item>
</selector>
