<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state (ESP32 DPAD selection) - Glowing BMW Amber Ring -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Outer Glow Layer -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#241400" />
                    <stroke android:width="4dp" android:color="@color/bmw_amber" />
                </shape>
            </item>
            <!-- Inner Bezel -->
            <item android:inset="6dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="180dp"
                        android:startColor="#1E2026"
                        android:endColor="#0A0B0D" />
                    <stroke android:width="2dp" android:color="@color/bmw_amber_light" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Pressed state -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#3B2200" />
                    <stroke android:width="4dp" android:color="@color/bmw_amber_light" />
                </shape>
            </item>
            <item android:inset="6dp">
                <shape android:shape="oval">
                    <solid android:color="#141519" />
                    <stroke android:width="2dp" android:color="@color/bmw_amber" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal / Unfocused state (Gunmetal cluster ring with dark face) -->
    <item>
        <layer-list>
            <!-- Outer Gunmetal Ring -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#17191E" />
                    <stroke android:width="3dp" android:color="#3C3F4A" />
                </shape>
            </item>
            <!-- Middle Accent Ring -->
            <item android:inset="5dp">
                <shape android:shape="oval">
                    <solid android:color="#121316" />
                    <stroke android:width="1.5dp" android:color="#282A31" />
                </shape>
            </item>
            <!-- Inner Deep Instrument Face -->
            <item android:inset="10dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="170dp"
                        android:startColor="#16181D"
                        android:endColor="#08080A" />
                    <stroke android:width="1dp" android:color="#1E2027" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
